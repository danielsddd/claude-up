# Secrets never go in the repo: API keys live in your own environment variables.
.env
.env.*
*.key
*.pem

# Written by Claude Code each time it loads a mod; machine-specific.
.claude-plugin/types/

# Local tooling
.venv/
venv/
__pycache__/
*.pyc
node_modules/
.DS_Store
Thumbs.db

# Local helpers for working on the repo; not part of what's shared.
CLAUDE.md
tsconfig.json

# Kept locally, not shipped: a mod folder holds only what Claude Code needs to run it.
mods/*/tests/
mods/*/tools/
mods/*/docs/
